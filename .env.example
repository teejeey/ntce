# --- Google Apps Script (server-side: Render / `next start` API routes call GAS) ---
GAS_WEB_APP_URL="https://script.google.com/macros/s/REPLACE_WITH_YOUR_DEPLOYMENT_ID/exec"
# Optional duplicate for client bundles if you use NEXT_PUBLIC_* only:
# NEXT_PUBLIC_GAS_WEB_APP_URL="https://script.google.com/macros/s/.../exec"

# --- Frontend calling the API from another host (e.g. static site on cPanel → Render API) ---
# Uncomment ONLY for split hosting: browser hits Render for `/api/...` (no trailing slash).
# NEXT_PUBLIC_API_BASE_URL="https://YOUR_SERVICE.onrender.com"
# Optional override: even on localhost, force browser/server to use NEXT_PUBLIC_API_BASE_URL.
# NEXT_PUBLIC_FORCE_REMOTE_API="1"

# Local `npm run dev` / standard Next hosting: leave NEXT_PUBLIC_API_BASE_URL unset → `/api/*` is same-origin (localhost).

# --- Optional: server-side absolute URL for this Next app (SSR / server fetches) ---
# NEXT_PUBLIC_SITE_URL="https://ntce.onrender.com"
# INTERNAL_APP_URL="http://127.0.0.1:3000"

# --- CORS on Render: if you set a comma-separated allowlist, include your cPanel site origin ---
# CORS_ALLOWED_ORIGINS="https://www.yourdomain.bt,https://yourdomain.bt"
# If unset, API routes allow any origin with Access-Control-Allow-Origin: *
